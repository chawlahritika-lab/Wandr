# Optional planning agent configuration
# Provider precedence: Groq is checked first if GROQ_API_KEY is set, then Azure
# OpenAI (if fully configured), then Anthropic. Groq has a free tier - get a key
# at https://console.groq.com and this becomes the default provider automatically.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Set all Azure values to use Azure OpenAI. Anthropic is used when Azure is incomplete.
AZURE_OPENAI_ENDPOINT=https://ai-proxy.lab.epam.com
AZURE_OPENAI_API_KEY=replace-with-your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=anthropic.claude-sonnet-4-6
AZURE_OPENAI_API_VERSION=2024-10-21

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_VERSION=2023-06-01

AGENT_TIMEOUT_SECONDS=45
AGENT_MIN_CONFIDENCE=0.65

# Live research for destinations outside the local catalog
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_BASE_URL=https://maps.googleapis.com/maps/api/place
RESEARCH_TIMEOUT_SECONDS=20
RESEARCH_MAX_RESULTS=4
RESEARCH_CACHE_TTL_SECONDS=3600
